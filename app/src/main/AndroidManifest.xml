<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Baitaplap">

        <!-- Màn hình Lab 1 -->
        <activity
            android:name=".Lab1Activity"
            android:exported="false" />

        <!-- Màn hình Lab 2 (MÀN HÌNH CHÍNH KHỞI CHẠY) -->
        <activity
            android:name=".Lab2Activity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình Lab 3 (Chi tiết sinh viên) -->
        <activity
            android:name=".Lab3DetailActivity"
            android:exported="false" />

        <!-- Màn hình Lab 4 (Theme & Dark Mode) -->
        <activity
            android:name=".Lab4ThemeActivity"
            android:exported="false" />

        <!-- Màn hình Lab 5 (UI State) -->
        <activity
            android:name=".Lab5UiStateActivity"
            android:exported="false" />

        <!-- Màn hình MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>